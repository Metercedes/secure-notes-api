# Required. Base64, at least 256 bits. Generate with: openssl rand -base64 48
SECURITY_JWT_SECRET=

# Optional overrides
SECURITY_JWT_ACCESS_EXPIRATION=15m
SECURITY_JWT_REFRESH_EXPIRATION=24h
SECURITY_RATE_LIMIT_RPM=60
SECURITY_RATE_LIMIT_AUTH_RPM=10
# Only enable behind a reverse proxy that overwrites X-Forwarded-For
SECURITY_RATE_LIMIT_TRUST_XFF=false
DB_URL=jdbc:h2:file:./data/notes;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
